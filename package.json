{
  "name": "pullshelf",
  "productName": "Pullshelf",
  "version": "0.1.1",
  "private": true,
  "description": "A pull-down shelf for the tools you already run.",
  "license": "MIT",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "compile:gesture": "mkdir -p native/bin && swiftc -swift-version 5 -target $(uname -m)-apple-macos13.0 -O -framework AppKit -framework ApplicationServices -o native/bin/GestureHelper native/GestureHelper.swift",
    "rebuild": "electron-rebuild -f -w node-pty,better-sqlite3",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node test/e2e/run.mjs",
    "package": "node build/package.mjs",
    "package:dir": "node build/package.mjs --dir",
    "demo": "node build/demo/make-demo.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "node-pty@1.1.0": true,
    "better-sqlite3@13.0.3": true
  },
  "build": {
    "appId": "io.github.yogeshvar.pullshelf",
    "productName": "Pullshelf",
    "artifactName": "${productName}-${version}-arm64.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!node_modules/node-pty/{deps,src,scripts,third_party,typings}/**",
      "!node_modules/node-pty/prebuilds/win32-*/**",
      "!node_modules/node-pty/prebuilds/darwin-x64/**",
      "!node_modules/node-pty/lib/**/*.test.*",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!node_modules/better-sqlite3/prebuilds/{win32-*,linux-*,linuxmusl-*,darwin-x64}.node"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "extraResources": [
      {
        "from": "native/bin/GestureHelper",
        "to": "GestureHelper"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Copyright \u00a9 2026 Pullshelf contributors. MIT License."
      }
    }
  }
}
